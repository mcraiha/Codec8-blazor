@page "/"

<PageTitle>Codec8 with Blazor</PageTitle>
<label for="userinput">Please write or paste the Codec8 or Codec8 Extended to text area below</label>
<textarea @bind="Codec8Hex" @bind:event="oninput" id="userinput" name="userinput" />
<label for="addhexes">Should dashes (-) be added to hex codes</label>
<input @bind="DashHexes" type="checkbox" id="addhexes" name="addhexes" />

@if (!string.IsNullOrEmpty(possibleError))
{
    <p>⚠️ Following error occurred:</p>
    <code>@possibleError</code>
}
else
{
    <p>Mandatory parts</p>
    @if (frameTcp != null)
    {
        <p><a href="@currentInputAsURL" target="_blank">Share (🔗)</a></p>
        <Codec8Mandatory Frame="@frameTcp" DashHexes="@DashHexes" />
        {
            int recordNumber = 1;
            @foreach (AvlDataCodec8 avlData in frameTcp.GetAvlDatas())
            {
                GPSElement gps = avlData.GetGPSElement();
                IOElementCodec8 ioElement = avlData.GetIOElement();
                
                <Codec8Avl AVLData="@avlData" GPS="@gps" IOElement="@ioElement" RecordNumber="@recordNumber" DashHexes="@DashHexes" />
                recordNumber++;
            }
        }
    }
    else if (frameExtendedTcp != null)
    {
        <p><a href="@currentInputAsURL" target="_blank">Share (🔗)</a></p>
        <Codec8ExtendedMandatory Frame="@frameExtendedTcp" DashHexes="@DashHexes" />
        {
            int recordNumber = 1;
            @foreach (AvlDataCodec8Extended avlData in frameExtendedTcp.GetAvlDatas())
            {
                GPSElement gps = avlData.GetGPSElement();
                IOElementCodec8Extended ioElement = avlData.GetIOElement();
                
                <Codec8ExtendedAvl AVLData="@avlData" GPS="@gps" IOElement="@ioElement" RecordNumber="@recordNumber" DashHexes="@DashHexes" />
                recordNumber++;
            }
        }
    }
    else if (frameUdp != null)
    {
        <p><a href="@currentInputAsURL" target="_blank">Share (🔗)</a></p>
        <Codec8UdpMandatory Header="@header" AvlDataEncapsulated="@avlDataEncapsulated" Frame="@frameUdp" DashHexes="@DashHexes" />
        {
            int recordNumber = 1;
            @foreach (AvlDataCodec8 avlData in frameUdp.GetAvlDatas())
            {
                GPSElement gps = avlData.GetGPSElement();
                IOElementCodec8 ioElement = avlData.GetIOElement();
                
                <Codec8Avl AVLData="@avlData" GPS="@gps" IOElement="@ioElement" RecordNumber="@recordNumber" DashHexes="@DashHexes" />
                recordNumber++;
            }
        }
    }
    else if (frameExtendedUdp != null)
    {
        <p><a href="@currentInputAsURL" target="_blank">Share (🔗)</a></p>
        <Codec8ExtendedUdpMandatory Header="@header" AvlDataEncapsulated="@avlDataEncapsulated" Frame="@frameExtendedUdp" DashHexes="@DashHexes" />
        {
            int recordNumber = 1;
            @foreach (AvlDataCodec8Extended avlData in frameExtendedUdp.GetAvlDatas())
            {
                GPSElement gps = avlData.GetGPSElement();
                IOElementCodec8Extended ioElement = avlData.GetIOElement();
                
                <Codec8ExtendedAvl AVLData="@avlData" GPS="@gps" IOElement="@ioElement" RecordNumber="@recordNumber" DashHexes="@DashHexes" />
                recordNumber++;
            }
        }
    }
}

@code {
    private string contentActual = "";
    public string Codec8Hex 
    {
        get => contentActual;
        set
        {
            somethingDecoded = true;
            contentActual = value;
            if (!string.IsNullOrEmpty(value))
            {
                (GenericDecodeResult result, object valueOrError) = GenericDecoder.ParseHexadecimalString(value.Replace("-", string.Empty));

                if (result == GenericDecodeResult.SuccessCodec8)
                {
                    frameTcp = (Codec8Frame)valueOrError;
                    frameExtendedTcp = null;

                    header = null;
                    avlDataEncapsulated = null;
                    frameUdp = null;
                    frameExtendedUdp = null;

                    possibleError = "";
                    currentInputAsURL = $"https://codec8.raiha.rocks/?Input={contentActual}";
                }
                else if (result == GenericDecodeResult.SuccessCodec8Extended)
                {
                    frameTcp = null;
                    frameExtendedTcp = (Codec8ExtendedFrame)valueOrError;

                    header = null;
                    avlDataEncapsulated = null;
                    frameUdp = null;
                    frameExtendedUdp = null;

                    possibleError = "";
                    currentInputAsURL = $"https://codec8.raiha.rocks/?Input={contentActual}";
                }
                else if (result == GenericDecodeResult.SuccessCodec8Udp)
                {
                    frameTcp = null;
                    frameExtendedTcp = null;

                    (header, avlDataEncapsulated, frameUdp) = ((UdpChannelHeader a, AvlDataEncapsulated b, Codec8FrameNoCRC c))valueOrError;
                    frameExtendedUdp = null;

                    possibleError = "";
                    currentInputAsURL = $"https://codec8.raiha.rocks/?Input={contentActual}";
                }
                else if (result == GenericDecodeResult.SuccessCodec8ExtendedUdp)
                {
                    frameTcp = null;
                    frameExtendedTcp = null;

                    (header, avlDataEncapsulated, frameExtendedUdp) = ((UdpChannelHeader a, AvlDataEncapsulated b, Codec8ExtendedFrameNoCRC c))valueOrError;
                    frameUdp = null;

                    possibleError = "";
                    currentInputAsURL = $"https://codec8.raiha.rocks/?Input={contentActual}";
                }
                else
                {
                    frameTcp = null;
                    frameExtendedTcp = null;

                    header = null;
                    avlDataEncapsulated = null;
                    frameUdp = null;
                    frameExtendedUdp = null;

                    possibleError = (string)valueOrError;
                    currentInputAsURL = "";
                }
            }
        } 
    }

    public bool DashHexes { get; set; } = false;

    private bool somethingDecoded = false;
    private GenericDecodeResult result = GenericDecodeResult.InputNullOrEmpty;

    private Codec8Frame? frameTcp = null;
    private Codec8ExtendedFrame? frameExtendedTcp = null;

    private UdpChannelHeader? header = null;
    private AvlDataEncapsulated? avlDataEncapsulated = null;

    private Codec8FrameNoCRC? frameUdp = null;
    private Codec8ExtendedFrameNoCRC? frameExtendedUdp = null;

    private string possibleError = "";
    private string currentInputAsURL = "";

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Input 
    { 
        get => ""; 
        set
        {
            if (!string.IsNullOrEmpty(value))
            {
                Codec8Hex = value;
            }
        }
    }
}